---
layout: base/base.njk
title: "Packages"
description: ""
---

<style>
    .swiper {
        width: 100%;
        height: 100%;
    }

    .swiper-wrapper {
        align-items: stretch !important;
    }

    .swiper-slide {
        width: 450px;
        height: auto !important;
    }

    @media (max-width: 768px) {
        .swiper-slide {
            width: 100%;
        }
    }

    .swiper-button-next::after,
    .swiper-button-prev::after {
        content: none;
    }

    .swiper-button-next,
    .swiper-button-prev {
        position: static;
        transform: none;
        inset: auto;
        width: 44px;
        height: 44px;
        padding: 10px;
        background-color: #E6E3D1;
        border: none;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .swiper-button-next img,
    .swiper-button-prev img {
        width: 24px;
        height: 24px;
    }
</style>

<section class="pt-[180px] pb-[180px] sticky top-0 z-5 bg-cream">
    <div class="container">
        <div class="flex flex-col items-center">
            <h1 class="text-navy heading-1-bold">Packages</h1>
        </div>
    </div>
</section>

<!-- Hannah Video Section -->
<section class="bg-white py-[80px] relative z-10">
    <div class="container">
        <div class="flex flex-col lg:flex-row gap-[20px]">
            <div class="flex flex-col flex-1 gap-[20px] justify-center items-center text-center">
                <h2 class="text-navy heading-2-bold">Welcome!</h2>
                <p class="body-text max-w-md">Our coach Hannah answers some common questions about our packages.</p>
            </div>
            <div class="flex flex-col flex-1 gap-[20px] justify-center items-center">
                <div class="overflow-hidden rounded-[10px] w-full">
                    <video controls preload="metadata" class="w-full h-auto">
                        <source src="/assets/videos/audio/packages-hannah.mp4" type="video/mp4">
                    </video>
                </div>
            </div>
        </div>
    </div>
    <div class="absolute top-[-100px] left-0 w-screen h-[100px] overflow-hidden">
        <img src="/assets/svgs/section-cloud.svg" alt=""
            class="absolute inset-0 w-full h-full object-cover object-center">
    </div>
</section>

<!-- Carley's Video Section -->
<section class="bg-cream py-[80px] relative z-10">
    <div class="container">
        <div class="flex flex-col lg:flex-row gap-[80px] justify-center items-center">
            <div class="flex flex-col flex-1 gap-[20px] justify-center items-center order-last lg:order-first">
                <div class="overflow-hidden rounded-[10px] w-full">
                    <video controls preload="metadata" class="w-full h-auto">
                        <source src="/assets/videos/audio/packages-carley.mp4" type="video/mp4">
                    </video>
                </div>
            </div>
            <div class="flex flex-col flex-1 gap-[20px] justify-center items-center text-center">
                <h2 class="text-navy heading-2-bold lg:max-w-md">Which package should I book?</h2>
                <p class="body-text max-w-md">Our Coach Carley explains the differences between the packages so you can
                    find the right one for you!</p>
            </div>
        </div>
    </div>
</section>

<!-- Packages Section -->
<section class="bg-navy py-[80px] relative z-10">
    <div class="container">
        <div class="flex flex-col gap-[20px]">
            <div class="flex flex-col gap-[60px]">
                <h2 class="text-white heading-2-bold text-center">Explore Our Packages</h2>
                <div class="swiper mySwiper relative">
                    <div class="swiper-wrapper">
                        {%- for package in packages %}
                        <div class="swiper-slide">
                            <div class="bg-cream rounded-[10px] py-[20px] px-[30px] h-full w-full">
                                <div class="flex flex-col gap-[20px] justify-between h-full">
                                    <div class="flex flex-col gap-[20px]">
                                        <div class="flex flex-col gap-[10px]">
                                            <h3 class="heading-5-bold text-navy">{{ package.name }}</h3>
                                            <h3 class="heading-6-normal text-navy">{{ package.price }}</h3>
                                        </div>
                                        <ul class="flex flex-col gap-[10px]">
                                            {%- if package.features %}
                                            {%- for feature in package.features %}
                                            <li class="flex gap-[5px]">
                                                <img src="/assets/svgs/check.svg" aria-hidden="true"
                                                    class="w-[24px] h-[24px] bg-[#E6E3D1] rounded-full p-[4px]">
                                                <p class="body-text text-navy">{{ feature }}</p>
                                            </li>
                                            {%- endfor %}
                                            {%- endif %}
                                            {%- if package.extras %}
                                            {%- for extra in package.extras %}
                                            <li>
                                                <p class="body-text text-navy">{{ extra }}</p>
                                            </li>
                                            {%- endfor %}
                                            {%- endif %}
                                        </ul>
                                    </div>
                                    <div class="flex flex-col gap-[20px]">
                                        <p class="small text-navy">{{ package.description }}</p>
                                        <a href="{{ package.url }}" target="_blank" rel="noopener noreferrer"
                                            class="button-primary text-center">Book Now</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {%- endfor %}
                    </div>
                </div>
            </div>
            <div class="flex justify-between items-center gap-[40px]">
                <p class="text-xs text-white">*Prices are shown in GBP (£), but will be charged as the currency
                    equivalent.</p>
                <div class="flex justify-end gap-[10px] pt-[20px]">
                    <button class="swiper-button-prev" type="button">
                        <img src="/assets/svgs/chevron-left.svg" alt="Previous package">
                    </button>
                    <button class="swiper-button-next" type="button">
                        <img src="/assets/svgs/chevron-right.svg" alt="Next package">
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Bottom Section -->
<section class="bg-white py-[80px] z-10 relative mb-[656px] sm:mb-[464px]">
    <div class="container h-full">
        <div class="flex flex-col lg:flex-row gap-[40px]">
            <div class="flex flex-col flex-1 gap-[20px]">
                <h2 class="text-navy heading-2-bold">Frequently Asked Questions</h2>
                <p class="body-text hidden lg:block">Still have a question? <br>Reach out to us by
                    <a href="mailto:itav.sleep@gmail.com" class="text-teal underline">email</a> or
                    <a href="https://www.instagram.com/ittakesavillage_baby_sleep/" class="text-teal underline"
                        target="_blank" rel="noopener noreferrer">Instagram</a>.
                </p>
            </div>
            <div class="flex flex-col w-full flex-1">
                {%- for faq in faqs.packages %}
                <div
                    class="w-full flex flex-col {% if loop.first %}pb-[20px]{% else %}pt-[20px] pb-[20px]{% endif %} border-b-[3px] border-dashed border-terqoise">
                    <button class="flex items-center cursor-pointer gap-[12px]" aria-expanded="false"
                        data-accordion-trigger type="button">
                        <span class="flex items-center w-[40px] h-[40px]">
                            <img src="/assets/svgs/accordion-moon.svg" alt="Moon Icon" class="block w-[32px]"
                                data-icon-plus>
                            <img src="/assets/svgs/accordion-sun.svg" alt="Sun Icon" class="hidden w-[40px]"
                                data-icon-minus>
                        </span>
                        <span class="text-navy heading-6-medium text-left">{{ faq.question }}</span>
                    </button>
                    <div class="w-full overflow-hidden transition-[max-height] duration-500 ease-in-out"
                        data-accordion-content>
                        <span class="text-navy mt-[20px]">{{ faq.answer }}</span>
                    </div>
                </div>
                {%- endfor %}
            </div>
            <p class="body-text lg:hidden">Still have a question? <br>Reach out to us by
                <a href="mailto:itav.sleep@gmail.com" class="text-teal underline">email</a> or
                <a class="text-teal underline" href="https://www.instagram.com/ittakesavillage_baby_sleep/"
                    target="_blank" rel="noopener noreferrer">Instagram</a>.
            </p>
        </div>
    </div>
    <div class="absolute bottom-[-100px] left-0 w-screen h-[100px] overflow-hidden">
        <img src="/assets/svgs/section-cloud.svg" alt=""
            class="absolute rotate-180 inset-0 w-full h-full object-cover object-center">
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
    document.querySelectorAll('[data-accordion-trigger]').forEach(button => {
        const content = button.nextElementSibling;
        const iconPlus = button.querySelector('[data-icon-plus]');
        const iconMinus = button.querySelector('[data-icon-minus]');

        button.addEventListener('click', () => {
            const isExpanded = button.getAttribute('aria-expanded') === 'true';

            if (isExpanded) {
                content.style.maxHeight = '0';
                button.setAttribute('aria-expanded', 'false');
                iconPlus.classList.remove('hidden');
                iconMinus.classList.add('hidden');
            } else {
                content.style.maxHeight = content.scrollHeight + 'px';
                button.setAttribute('aria-expanded', 'true');
                iconPlus.classList.add('hidden');
                iconMinus.classList.remove('hidden');
            }
        });
    });
</script>

<script>
    var swiper = new Swiper(".mySwiper", {
        slidesPerView: "auto",
        spaceBetween: 20,
        navigation: {
            nextEl: ".swiper-button-next",
            prevEl: ".swiper-button-prev",
        },
    });
</script>
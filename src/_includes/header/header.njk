<header
    class="py-[10px] lg:py-[20px] transition-colors duration-300 fixed top-0 left-0 right-0 z-50 w-full bg-cream body !font-bold"
    id="site-header">
    <div class="mx-auto px-[24px] flex items-center justify-between text-navy">
        <a href="/" class="bg-cream p-[5px] rounded-[10px]" aria-label="{{ site.title }} Home">
            <img src="/assets/svgs/logo_no_text.svg" class="w-[50px] h-[50px]" alt="{{ site.title }} logo">
        </a>

        <!-- Desktop Nav -->
        <nav class="hidden lg:flex items-center gap-[20px]">
            <div class="flex items-center">
                {%- for item in navigation %}
                {%- if item.type != 'cta' %}
                <a href="{{ item.url }}"
                    class="flex items-center hover:text-terqoise px-[12px] py-[16px]{%- if page.url == item.url or (item.url != '/' and page.url.startsWith(item.url)) %} nav-link-active{%- endif %}">
                    {{ item.label }}
                </a>
                {%- endif %}
                {%- endfor %}
            </div>
            <div class="flex items-center gap-[20px]">
                <a href="https://www.instagram.com/ittakesavillage_baby_sleep/" target="_blank"
                    aria-label="Follow us on Instagram">

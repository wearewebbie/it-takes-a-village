                        class="text-navy hover:text-terqoise w-[20px] h-[20px]">
                        <path fill="currentColor"
                            d="M22.5 9.84202C20.4357 9.84696 18.4221 9.20321 16.7435 8.00171V16.3813C16.7429 17.9333 16.2685 19.4482 15.3838 20.7233C14.499 21.9984 13.246 22.973 11.7923 23.5168C10.3387 24.0606 8.75362 24.1477 7.24914 23.7664C5.74466 23.3851 4.39245 22.5536 3.37333 21.383C2.3542 20.2125 1.71674 18.7587 1.54617 17.2161C1.3756 15.6735 1.68007 14.1156 2.41884 12.7507C3.15762 11.3858 4.2955 10.279 5.68034 9.57823C7.06517 8.87746 8.63095 8.61616 10.1683 8.82927V13.0439C9.46481 12.8227 8.70938 12.8293 8.0099 13.063C7.31041 13.2966 6.70265 13.7453 6.2734 14.345C5.84415 14.9446 5.61536 15.6646 5.6197 16.402C5.62404 17.1395 5.8613 17.8567 6.29759 18.4512C6.73387 19.0458 7.34688 19.4873 8.04906 19.7127C8.75125 19.9381 9.5067 19.9359 10.2075 19.7063C10.9084 19.4768 11.5188 19.0316 11.9515 18.4345C12.3843 17.8374 12.6173 17.1188 12.6173 16.3813V0H16.7435C16.7406 0.348435 16.7698 0.696395 16.8307 1.03948C16.9741 1.80537 17.2722 2.53396 17.7068 3.18068C18.1415 3.8274 18.7035 4.37867 19.3585 4.80075C20.2903 5.41688 21.3829 5.74528 22.5 5.74505V9.84202Z">
                        </path>
                    </svg>
                </a>
            </div>
            {%- for item in navigation %}
            {%- if item.type == 'cta' %}
            <a href="{{ item.url }}" class="flex items-center button-primary">{{ item.label }}</a>
            {%- endif %}
            {%- endfor %}
        </nav>

        <div class="lg:hidden">
            <button id="menu-btn" class="hamburger" aria-label="Menu" aria-expanded="false" type="button">
                <span class="bar" id="bar1"></span>
                <span class="bar" id="bar2"></span>
                <span class="bar" id="bar3"></span>
            </button>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="fixed top-[80px] inset-0 flex items-center bg-navy text-cream overflow-y-auto z-50
            opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="flex flex-col justify-between h-full w-full px-[60px] pb-[40px] pt-[100px]">
            <div class="flex flex-col gap-[20px] text-left">
                {%- for item in navigation %}
                {%- if item.type != 'cta' %}
                <a href="{{ item.url }}"
                    class="{%- if page.url == item.url or (item.url != '/' and page.url.startsWith(item.url)) %}nav-link-active {% endif %}heading-2-bold">
                    {{ item.label }}
                </a>
                {%- endif %}
                {%- endfor %}
            </div>
            {%- for item in navigation %}
            {%- if item.type == 'cta' %}
            <a href="{{ item.url }}" class="button-primary w-full text-center">{{ item.label }}</a>
            {%- endif %}
            {%- endfor %}
        </div>
    </div>
</header>

<script>
    const menuBtn = document.getElementById("menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const siteHeader = document.getElementById("site-header");
    const bar1 = document.getElementById("bar1");
    const bar2 = document.getElementById("bar2");
    const bar3 = document.getElementById("bar3");

    function closeMobileMenu() {
        menuBtn.classList.remove("open");
        mobileMenu.classList.remove("opacity-100", "pointer-events-auto");
        mobileMenu.classList.add("opacity-0", "pointer-events-none");
        document.body.classList.remove("overflow-hidden");
        siteHeader.classList.remove("bg-navy");
        bar1.classList.remove("bg-cream!");
        bar2.classList.remove("bg-cream!");
        bar3.classList.remove("bg-cream!");
    }

    function toggleMenu() {
        const isOpen = menuBtn.classList.contains("open");
        if (isOpen) {
            closeMobileMenu();
        } else {
            menuBtn.classList.add("open");
            mobileMenu.classList.remove("opacity-0", "pointer-events-none");
            mobileMenu.classList.add("opacity-100", "pointer-events-auto");
            document.body.classList.add("overflow-hidden");
            siteHeader.classList.add("bg-navy");
            bar1.classList.add("bg-cream!");
            bar2.classList.add("bg-cream!");
            bar3.classList.add("bg-cream!");
        }
    }

    menuBtn.addEventListener("click", toggleMenu);

    mobileMenu.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", closeMobileMenu);
    });

    window.addEventListener("resize", () => {
        if (window.innerWidth >= 1024) {
            closeMobileMenu();
        }
    });
</script>
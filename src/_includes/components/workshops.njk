{%- set uid = id | default("workshops") %}

<style>
  .swiperWorkshops-{{ uid }} {
    width: 100%;
    height: 100%;
  }

  .swiperWorkshops-{{ uid }} .swiper-wrapper {
    align-items: stretch !important;
  }

  .swiperWorkshops-{{ uid }} .swiper-slide {
    width: 450px;
    height: auto !important;
  }

  @media (max-width: 768px) {
    .swiperWorkshops-{{ uid }} .swiper-slide {
      width: 100%;
    }
  }

  .workshops-nav-{{ uid }} .swiper-button-next::after,
  .workshops-nav-{{ uid }} .swiper-button-prev::after {
    content: none;
  }

  .workshops-nav-{{ uid }} .swiper-button-next,
  .workshops-nav-{{ uid }} .swiper-button-prev {
    position: static;
    transform: none;
    inset: auto;
    width: 44px;
    height: 44px;
    padding: 10px;
    background-color: #E6E3D1;
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .workshops-nav-{{ uid }} .swiper-button-next img,
  .workshops-nav-{{ uid }} .swiper-button-prev img {
    width: 24px;
    height: 24px;
  }
</style>

<div class="flex flex-col gap-[20px]">
  <div class="flex flex-col gap-[60px]">
    <h2 class="text-white heading-2-bold text-center">Explore Our Workshops</h2>
    <div class="swiper swiperWorkshops-{{ uid }}">
      <div class="swiper-wrapper">
        {%- for workshop in workshops %}
        {%- if not workshop.comingSoon %}
        <div class="swiper-slide">
          <div class="bg-cream rounded-[10px] py-[20px] px-[30px] h-full w-full">
            <div class="flex flex-col gap-[20px] justify-between h-full">
              <div class="flex flex-col gap-[20px]">
                <div class="flex flex-col gap-[10px]">
                  <h3 class="heading-5-bold text-navy">{{ workshop.name }}</h3>
                  <h3 class="heading-6-normal text-navy">{{ workshop.age }}</h3>
                  <h3 class="heading-6-normal text-navy">{{ workshop.price }}</h3>
                </div>
                <ul class="flex flex-col gap-[10px]">
                  {%- if workshop.features %}
                  {%- for feature in workshop.features %}
                  <li class="flex gap-[5px]">
                    <img src="/assets/svgs/check.svg" aria-hidden="true"
                      class="w-[24px] h-[24px] bg-[#E6E3D1] rounded-full p-[4px]">
                    <p class="body-text text-navy">{{ feature }}</p>
                  </li>
                  {%- endfor %}
                  {%- endif %}
                  {%- if workshop.extras %}
                  {%- for extra in workshop.extras %}
                  <li>
                    <p class="body-text text-navy">{{ extra }}</p>
                  </li>
                  {%- endfor %}
                  {%- endif %}
                </ul>
              </div>
              <div class="flex flex-col gap-[20px]">
                <p class="small text-navy">{{ workshop.description }}</p>
                <div class="flex gap-[10px]">
                  <a href="{{ workshop.url }}" target="_blank" rel="noopener noreferrer"
                    class="button-primary text-center flex-1 min-w-0">Book Now</a>
                  <button type="button" data-modal-open="{{ uid }}-{{ loop.index0 }}"
                    class="button-outline text-center flex-1 min-w-0">More Info</button>
                </div>
              </div>
            </div>
          </div>
        </div>
        {%- endif %}
        {%- endfor %}
      </div>
    </div>
  </div>
  <div class="flex justify-between items-center gap-[40px] workshops-nav-{{ uid }}">
    <p class="text-xs text-white">*Prices are shown in GBP (£), but will be charged as the currency
      equivalent.</p>
    <div class="flex justify-end gap-[10px] pt-[20px]">
      <button class="swiper-button-prev" type="button">
        <img src="/assets/svgs/chevron-left.svg" alt="Previous package">
      </button>
      <button class="swiper-button-next" type="button">
        <img src="/assets/svgs/chevron-right.svg" alt="Next package">
      </button>
    </div>
  </div>
</div>

{%- set comingSoon = [] %}
{%- for workshop in workshops %}
{%- if workshop.comingSoon %}
{%- set _ = comingSoon.push(workshop.name) %}
{%- endif %}
{%- endfor %}
{%- if comingSoon.length %}
<section class="flex flex-col gap-[40px] sm:gap-[60px] pt-[60px] sm:pt-[80px] px-[20px]">
  <h2 class="text-white heading-2-bold text-center">Workshops Coming Soon</h2>
  <div class="flex flex-wrap justify-center gap-[20px]">
    {%- for name in comingSoon %}
    <div class="relative bg-cream rounded-[20px] py-[28px] px-[28px] sm:py-[36px] sm:px-[40px] flex flex-col gap-[16px] w-full max-w-[440px]">
      <div class="flex justify-end">
        <span class="bg-terqoise text-navy text-small-bold tracking-wide py-[7px] px-[14px] rounded-full">
          Coming Soon
        </span>
      </div>
      <h3 class="heading-5-bold text-navy">{{ name }} Workshop</h3>
      <p class="text-small text-navy">Keep an eye on this new workshop. More details coming soon.</p>
    </div>
    {%- endfor %}
  </div>
</section>
{%- endif %}

{%- for workshop in workshops %}
{%- if not workshop.comingSoon %}
{%- set modalId = uid ~ "-" ~ loop.index0 %}
{%- set entry = workshop %}
{% include "components/workshop-modal.njk" %}
{%- endif %}
{%- endfor %}

{% include "components/modal-assets.njk" %}

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
  (function () {
    var uid = '{{ uid }}';
    var container = '.swiperWorkshops-' + uid;
    var nav = '.workshops-nav-' + uid;

    new Swiper(container, {
      slidesPerView: 'auto',
      spaceBetween: 20,
      navigation: {
        nextEl: nav + ' .swiper-button-next',
        prevEl: nav + ' .swiper-button-prev',
      },
    });
  })();
</script>
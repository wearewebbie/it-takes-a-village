<style>
  dialog {
    border: none;
    opacity: 0;
    transform: scale(0.95);
    transition: opacity 0.3s ease, transform 0.3s ease, display 0.3s ease allow-discrete;
  }

  dialog[open] {
    opacity: 1;
    transform: scale(1);
  }

  @starting-style {
    dialog[open] {
      opacity: 0;
      transform: scale(0.95);
    }
  }

  dialog::backdrop {
    opacity: 0;
    transition: opacity 0.3s ease, display 0.3s ease allow-discrete;
  }

  dialog[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    dialog[open]::backdrop {
      opacity: 0;
    }
  }

  dialog.closing {
    opacity: 0;
    transform: scale(0.95);
  }

  dialog.closing::backdrop {
    opacity: 0;
  }

  @media (max-width: 767px) {
    dialog {
      max-width: none;
      max-height: none;
    }
  }

  @media (min-width: 768px) {
    .team-card {
      --rotation: 0deg;
      transform: rotate(var(--rotation));
    }

    .team-card:hover {
      transform: rotate(0deg) scale(1.1);
      z-index: 20;
    }
  }
</style>

{%- set uid = id | default("team") %}

<div class="flex flex-col gap-[30px]">
  <div class="container">
    <div class="flex flex-col gap-[20px]">
      <h2 class="text-terqoise heading-2-bold text-center">Meet our Sleep Consultants</h2>
      <p class="body text-navy text-center max-w-3xl mx-auto">
        As some of the most highly qualified sleep consultants in the field, we provide holistic, evidence-informed
        support that respects your child and your parenting values. We never use cry-it-out methods—instead, we offer
        gentle, personalised guidance to help your family find a path that feels right for you.
      </p>
    </div>
  </div>

  <!-- Mobile: Swiper carousel -->
  <div class="md:hidden">
    <div class="swiper swiperTeam-{{ uid }} py-[40px]">
      <div class="swiper-wrapper">
        {%- for member in team %}
        {%- if member.bio.length > 0 %}
        <div class="swiper-slide">
          <div
            class="relative aspect-[3/4] border-t-[10px] border-r-[10px] border-l-[10px] border-navy rounded-[10px] overflow-hidden shadow-lg mx-auto cursor-pointer bg-cream flex items-end justify-center"
            data-team-card="{{ uid }}" data-name="{{ member.name }}">
            {% image member.image, "Portrait of " + member.name, "w-full h-auto max-h-[400px] object-contain pt-[20px]
            px-[20px]" %}
            <div class="absolute bottom-0 left-0 right-0 flex items-center justify-between px-[16px] py-[24px] bg-navy">
              <span class="body-bold text-white">{{ member.name }}</span>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5"
                stroke="currentColor" class="w-[16px] h-[16px] text-white" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
              </svg>
            </div>
          </div>
        </div>
        {%- endif %}
        {%- endfor %}
      </div>
    </div>
  </div>

  <div class="container">
    <!-- Desktop: Overlapping fan layout -->
    <div class="hidden md:flex items-center justify-center py-[40px] -space-x-[40px]">
      {%- set rotations = ["-3deg", "1.5deg", "-1deg", "2deg", "-2deg"] %}
      {%- for member in team %}
      {%- if member.bio.length > 0 %}
      <div
        class="team-card relative flex-shrink-0 w-[180px] lg:w-[260px] aspect-[3/4] border-[10px] lg:border-[15px] border-navy rounded-[10px] overflow-hidden shadow-lg cursor-pointer transition-all duration-300 bg-cream flex items-end justify-center"
        style="--rotation: {{ rotations[loop.index0 % rotations.length] }};" data-team-card="{{ uid }}"
        data-name="{{ member.name }}">
        {% image member.image, "Portrait of " + member.name, "w-full h-auto max-h-[400px] object-contain pt-[20px]
        px-[20px]" %}
      </div>
      {%- endif %}
      {%- endfor %}
    </div>

    <div id="team-cursor-label-{{ uid }}"
      class="pointer-events-none fixed hidden rounded-full bg-white px-[16px] py-[8px] text-sm text-navy shadow-md z-50">
    </div>
  </div>
</div>

{%- for member in team %}
{%- if member.bio.length > 0 %}
<dialog id="modal-{{ uid }}-{{ member.name | lower }}"
  class="w-full h-full md:w-auto md:h-auto md:max-w-[900px] md:max-h-[600px] md:rounded-[20px] p-[30px] md:pb-[30px] m-0 md:m-auto backdrop:bg-black/50">
  <div class="flex flex-col md:flex-row gap-[24px] h-full">
    <button type="button" data-modal-close="{{ uid }}" aria-label="Close"
      class="cursor-pointer text-navy text-2xl leading-none w-[44px] min-h-[44px] bg-black/5 rounded-[5px] flex md:hidden items-center justify-center ml-auto flex-shrink-0">&times;</button>

    <div class="md:w-1/2 flex-shrink-0 flex items-end justify-center bg-cream rounded-[16px] pt-[60px] md:pt-[0px]">
      {% image member.image, "Portrait of " + member.name, "max-w-[80%] max-h-full object-contain mx-auto block" %}
    </div>
    <div class="md:w-1/2 relative">
      <div class="flex flex-col gap-[30px] md:overflow-y-auto md:max-h-full pb-[30px] md:pb-[0px]"
        data-modal-scroll="{{ uid }}">
        <div class="flex flex-col gap-[10px]">
          <div class="flex flex-row gap-[10px] justify-between items-center">
            <h3 class="text-navy heading-4-bold">{{ member.name }}</h3>
            <button type="button" data-modal-close="{{ uid }}" aria-label="Close"
              class="cursor-pointer text-navy text-2xl leading-none w-[44px] h-[44px] bg-black/5 rounded-[5px] hidden md:flex items-center justify-center ml-auto">&times;</button>
          </div>
          <p class="text-navy body-text font-medium">{{ member.role }}</p>
          <span class="inline-block bg-terqoise text-white small-light px-[12px] py-[4px] rounded-full w-fit">OCN Level
            6 Qualified</span>
        </div>
        {%- for paragraph in member.bio %}
        <p class="body-text">{{ paragraph }}</p>
        {%- endfor %}
      </div>
    </div>
  </div>
</dialog>
{%- endif %}
{%- endfor %}

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
  (function () {
    var uid = '{{ uid }}';

    var teamSwiper = new Swiper('.swiperTeam-' + uid, {
      slidesPerView: 1.3,
      centeredSlides: true,
      spaceBetween: 16,
    });

    var label = document.getElementById('team-cursor-label-' + uid);
    document.querySelectorAll('[data-team-card="' + uid + '"]').forEach(function (card) {
      card.addEventListener('mouseenter', function () {
        label.textContent = 'More about ' + card.dataset.name;
        label.classList.remove('hidden');
      });
      card.addEventListener('mousemove', function (e) {
        label.style.left = e.clientX + 15 + 'px';
        label.style.top = e.clientY + 15 + 'px';
      });
      card.addEventListener('mouseleave', function () {
        label.classList.add('hidden');
      });
      card.addEventListener('click', function () {
        label.classList.add('hidden');
        var modal = document.getElementById('modal-' + uid + '-' + card.dataset.name.toLowerCase());
        if (modal) {
          modal.showModal();
          document.body.style.overflow = 'hidden';
        }
      });
    });

    function closeDialog(dialog) {
      dialog.classList.add('closing');
      dialog.addEventListener('transitionend', function handler() {
        dialog.classList.remove('closing');
        dialog.close();
        document.body.style.overflow = '';
        dialog.removeEventListener('transitionend', handler);
      });
    }

    document.querySelectorAll('[data-modal-close="' + uid + '"]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        closeDialog(btn.closest('dialog'));
      });
    });

    document.querySelectorAll('dialog[id^="modal-' + uid + '-"]').forEach(function (dialog) {
      dialog.addEventListener('click', function (e) {
        if (e.target === dialog) closeDialog(dialog);
      });
      dialog.addEventListener('cancel', function (e) {
        e.preventDefault();
        closeDialog(dialog);
      });
    });

    function updateScrollMask(el) {
      var scrollTop = el.scrollTop;
      var scrollHeight = el.scrollHeight;
      var clientHeight = el.clientHeight;
      var atTop = scrollTop < 5;
      var atBottom = scrollTop + clientHeight >= scrollHeight - 5;
      var canScroll = scrollHeight > clientHeight;

      if (!canScroll) {
        el.style.maskImage = 'none';
        el.style.webkitMaskImage = 'none';
      } else if (atTop) {
        el.style.maskImage = 'linear-gradient(to bottom, black 80%, transparent 100%)';
        el.style.webkitMaskImage = 'linear-gradient(to bottom, black 80%, transparent 100%)';
      } else if (atBottom) {
        el.style.maskImage = 'linear-gradient(to top, black 80%, transparent 100%)';
        el.style.webkitMaskImage = 'linear-gradient(to top, black 80%, transparent 100%)';
      } else {
        el.style.maskImage = 'linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%)';
        el.style.webkitMaskImage = 'linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%)';
      }
    }

    document.querySelectorAll('[data-modal-scroll="' + uid + '"]').forEach(function (el) {
      el.addEventListener('scroll', function () { updateScrollMask(el); });
      var observer = new MutationObserver(function () {
        requestAnimationFrame(function () { updateScrollMask(el); });
      });
      observer.observe(el.closest('dialog'), { attributes: true });
    });
  })();
</script>
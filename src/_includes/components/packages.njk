{%- set uid = id | default("packages") %}

<style>
  .swiperPackages-{{ uid }} {
    width: 100%;
    height: 100%;
  }

  .swiperPackages-{{ uid }} .swiper-wrapper {
    align-items: stretch !important;
  }

  .swiperPackages-{{ uid }} .swiper-slide {
    width: 485px;
    height: auto !important;
  }

  @media (max-width: 768px) {
    .swiperPackages-{{ uid }} .swiper-slide {
      width: 100%;
    }
  }

  .packages-nav-{{ uid }} .swiper-button-next::after,
  .packages-nav-{{ uid }} .swiper-button-prev::after {
    content: none;
  }

  .packages-nav-{{ uid }} .swiper-button-next,
  .packages-nav-{{ uid }} .swiper-button-prev {
    position: static;
    transform: none;
    inset: auto;
    width: 44px;
    height: 44px;
    padding: 10px;
    background-color: #E6E3D1;
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .packages-nav-{{ uid }} .swiper-button-next img,
  .packages-nav-{{ uid }} .swiper-button-prev img {
    width: 24px;
    height: 24px;
  }

  .packages-tooltip-{{ uid }} {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
  }

  .packages-tooltip-trigger-{{ uid }}:hover+.packages-tooltip-{{ uid }},
  .packages-tooltip-trigger-{{ uid }}:focus-visible+.packages-tooltip-{{ uid }},
  .packages-tooltip-{{ uid }}:hover {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
</style>

<div class="flex flex-col gap-[20px]">
  <div class="flex flex-col gap-[60px]">
    <h2 class="text-white heading-2-bold text-center" data-reveal>Explore Our Packages</h2>
    <p class="body-text text-white text-center md:hidden -mt-[30px] -mb-[30px]" data-reveal data-reveal-delay="50">(Swipe for more...)</p>
    <div class="swiper swiperPackages-{{ uid }}">
      <div class="swiper-wrapper">
        {%- for package in packages %}
        <div class="swiper-slide">
          <div class="bg-cream rounded-[10px] py-[20px] px-[30px] h-full w-full" data-reveal
            data-reveal-delay="{{ (loop.index0 % 3) * 100 }}">
            <div class="flex flex-col gap-[20px] justify-between h-full">
              <div class="flex flex-col gap-[20px]">
                <div class="flex flex-col gap-[10px]">
                  <h3 class="heading-5-bold text-navy">{{ package.name }}</h3>
                  <h3 class="heading-6-normal text-navy">{{ package.age }}</h3>
                  <h3 class="heading-6-normal text-navy">{{ package.price }}</h3>
                </div>
                <ul class="flex flex-col gap-[10px]">
                  {%- if package.features %}
                  {%- for feature in package.features %}
                  <li class="flex gap-[5px]">
                    <img src="/assets/svgs/check.svg" aria-hidden="true"
                      class="w-[24px] h-[24px] bg-[#E6E3D1] rounded-full p-[4px]">
                    <p class="body-text text-navy">{{ feature }}</p>
                  </li>
                  {%- endfor %}
                  {%- endif %}
                  {%- if package.extras %}
                  {%- for extra in package.extras %}
                  <li>
                    <p class="body-text text-navy">{{ extra }}</p>
                  </li>
                  {%- endfor %}
                  {%- endif %}
                </ul>
              </div>
              <div class="flex flex-col gap-[20px]">
                <p class="small text-navy">{{ package.description }}</p>
                <div class="flex gap-[10px]">
                  <a href="{{ package.url }}" target="_blank" rel="noopener noreferrer"
                    class="button-primary text-center flex-1 min-w-0">Book Now</a>
                  <button type="button" data-modal-open="{{ uid }}-{{ loop.index0 }}"
                    class="button-outline text-center flex-1 min-w-0">More Info</button>
                </div>
              </div>
            </div>
          </div>
        </div>
        {%- endfor %}
      </div>
    </div>
  </div>
  <div class="flex justify-between items-center gap-[40px] packages-nav-{{ uid }}">
    <div class="relative flex items-center">
      <button type="button" class="packages-tooltip-trigger-{{ uid }} flex items-center justify-center w-[24px] h-[24px] rounded-full border border-white text-white text-xs font-bold cursor-pointer"
        aria-describedby="packages-tooltip-{{ uid }}">
        i
        <span class="sr-only">Package information</span>
      </button>
      <div id="packages-tooltip-{{ uid }}" role="tooltip"
        class="packages-tooltip-{{ uid }} absolute top-full left-0 mt-[10px] w-[500px] max-w-[90vw] flex flex-col gap-[8px] bg-cream rounded-[8px] p-[15px] shadow-lg transition-all duration-200 z-10">
        <p class="text-xs text-navy whitespace-normal lg:whitespace-nowrap">* Prices are shown in GBP (£), but will be charged as the currency equivalent</p>
        <p class="text-xs text-navy whitespace-normal lg:whitespace-nowrap">* You can upgrade between packages at any time</p>
        <p class="text-xs text-navy whitespace-normal lg:whitespace-nowrap">* More check-ins can be added at any time</p>
        <p class="text-xs text-navy whitespace-normal lg:whitespace-nowrap">* You can extend your time in the village at any time</p>
      </div>
    </div>
    <div class="flex justify-end gap-[10px] pt-[20px]">
      <button class="swiper-button-prev" type="button">
        <img src="/assets/svgs/chevron-left.svg" alt="Previous package">
      </button>
      <button class="swiper-button-next" type="button">
        <img src="/assets/svgs/chevron-right.svg" alt="Next package">
      </button>
    </div>
  </div>
</div>

{%- for package in packages %}
{%- set modalId = uid ~ "-" ~ loop.index0 %}
{%- set entry = package %}
{% include "components/workshop-modal.njk" %}
{%- endfor %}

{% include "components/modal-assets.njk" %}

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
  (function () {
    var uid = '{{ uid }}';
    var container = '.swiperPackages-' + uid;
    var nav = '.packages-nav-' + uid;

    new Swiper(container, {
      slidesPerView: 'auto',
      spaceBetween: 20,
      navigation: {
        nextEl: nav + ' .swiper-button-next',
        prevEl: nav + ' .swiper-button-prev',
      },
    });
  })();
</script>
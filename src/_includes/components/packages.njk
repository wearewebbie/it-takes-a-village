{%- set uid = id | default("packages") %}

<style>
  .swiperPackages-{{ uid }} {
    width: 100%;
    height: 100%;
  }

  .swiperPackages-{{ uid }} .swiper-wrapper {
    align-items: stretch !important;
  }

  .swiperPackages-{{ uid }} .swiper-slide {
    width: 450px;
    height: auto !important;
  }

  @media (max-width: 768px) {
    .swiperPackages-{{ uid }} .swiper-slide {
      width: 100%;
    }
  }

  .packages-nav-{{ uid }} .swiper-button-next::after,
  .packages-nav-{{ uid }} .swiper-button-prev::after {
    content: none;
  }

  .packages-nav-{{ uid }} .swiper-button-next,
  .packages-nav-{{ uid }} .swiper-button-prev {
    position: static;
    transform: none;
    inset: auto;
    width: 44px;
    height: 44px;
    padding: 10px;
    background-color: #E6E3D1;
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .packages-nav-{{ uid }} .swiper-button-next img,
  .packages-nav-{{ uid }} .swiper-button-prev img {
    width: 24px;
    height: 24px;
  }
</style>

<div class="flex flex-col gap-[20px]">
  <div class="flex flex-col gap-[60px]">
    <h2 class="text-white heading-2-bold text-center">Explore Our Packages</h2>
    <div class="swiper swiperPackages-{{ uid }}">
      <div class="swiper-wrapper">
        {%- for package in packages %}
        <div class="swiper-slide">
          <div class="bg-cream rounded-[10px] py-[20px] px-[30px] h-full w-full">
            <div class="flex flex-col gap-[20px] justify-between h-full">
              <div class="flex flex-col gap-[20px]">
                <div class="flex flex-col gap-[10px]">
                  <h3 class="heading-5-bold text-navy">{{ package.name }}</h3>
                  <h3 class="heading-6-normal text-navy">{{ package.price }}</h3>
                </div>
                <ul class="flex flex-col gap-[10px]">
                  {%- if package.features %}
                  {%- for feature in package.features %}
                  <li class="flex gap-[5px]">
                    <img src="/assets/svgs/check.svg" aria-hidden="true"
                      class="w-[24px] h-[24px] bg-[#E6E3D1] rounded-full p-[4px]">
                    <p class="body-text text-navy">{{ feature }}</p>
                  </li>
                  {%- endfor %}
                  {%- endif %}
                  {%- if package.extras %}
                  {%- for extra in package.extras %}
                  <li>
                    <p class="body-text text-navy">{{ extra }}</p>
                  </li>
                  {%- endfor %}
                  {%- endif %}
                </ul>
              </div>
              <div class="flex flex-col gap-[20px]">
                <p class="small text-navy">{{ package.description }}</p>
                <a href="{{ package.url }}" target="_blank" rel="noopener noreferrer"
                  class="button-primary text-center">Book Now</a>
              </div>
            </div>
          </div>
        </div>
        {%- endfor %}
      </div>
    </div>
  </div>
  <div class="flex justify-between items-center gap-[40px] packages-nav-{{ uid }}">
    <p class="text-xs text-white">*Prices are shown in GBP (£), but will be charged as the currency
      equivalent.</p>
    <div class="flex justify-end gap-[10px] pt-[20px]">
      <button class="swiper-button-prev" type="button">
        <img src="/assets/svgs/chevron-left.svg" alt="Previous package">
      </button>
      <button class="swiper-button-next" type="button">
        <img src="/assets/svgs/chevron-right.svg" alt="Next package">
      </button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
  (function () {
    var uid = '{{ uid }}';
    var container = '.swiperPackages-' + uid;
    var nav = '.packages-nav-' + uid;

    new Swiper(container, {
      slidesPerView: 'auto',
      spaceBetween: 20,
      navigation: {
        nextEl: nav + ' .swiper-button-next',
        prevEl: nav + ' .swiper-button-prev',
      },
    });
  })();
</script>

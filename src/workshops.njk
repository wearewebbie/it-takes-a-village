---
layout: base/base.njk
title: "Workshops"
description: ""
---

<section class="pt-[180px] pb-[180px] sticky top-0 z-5 bg-cream">
    <div class="container">
        <div class="flex flex-col items-center">
            <h1 class="text-navy heading-1-bold" data-reveal>Workshops</h1>
        </div>
    </div>
</section>


<!-- Workshop intro section -->
<section class="bg-white py-[80px] relative z-10">
    <div class="container">
    <div class="flex flex-col gap-[40px]">
      <h2 class="text-terqoise heading-2-bold text-center" data-reveal>Check out our selection of workshops</h2>
      <p class="body text-navy text-center max-w-3xl mx-auto" data-reveal data-reveal-delay="100">
        As some of the most highly qualified sleep consultants in the field, we provide holistic, evidence-informed
        support that respects your child and your parenting values. We never use cry-it-out methods—instead, we offer
        gentle, personalised guidance to help your family find a path that feels right for you.
      </p>
    </div>
  </div>

  <div class="absolute top-[-100px] left-0 w-screen h-[100px] overflow-hidden">
    <img src="/assets/svgs/section-cloud.svg" aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-top">
  </div>
</section>

<!-- Workshops Section -->
<section class="bg-navy py-[80px] relative z-20">
    <div class="container">
                <div class="flex flex-col gap-[20px]">
            <div class="flex flex-col gap-[60px]">
                <h2 class="text-cream heading-2-bold text-center" data-reveal>Explore Our Workshops</h2>
                <p class="body-text text-cream text-center md:hidden -mt-[30px] -mb-[30px]" data-reveal data-reveal-delay="50">(Swipe for more...)</p>
                {%- set variant = "cream" %}
        {% include "components/workshops.njk" %}
    </div>
              </div>
        </div>
</section>

<!-- Testimonials Section -->
<section class="bg-cream pt-[80px] pb-[180px] relative z-10">
    <div class="container">
        {%- set testimonialType = "workshop" %}
        {% include "components/testimonials.njk" %}
    </div>

        <div class="absolute bottom-0 left-0 w-screen h-[100px] overflow-hidden">
        <img src="/assets/svgs/section-cloud.svg" aria-hidden="true" focusable="false"
            class="absolute inset-0 w-full h-full object-cover object-top">
    </div>
    
</section>

<!-- Workshops Coming Soon Section -->
<section class="bg-white py-[80px] z-10 relative mb-[656px] sm:mb-[464px]">
    <div class="container relative z-20">
        <div class="flex flex-col lg:flex-row gap-[40px]">
            <div class="flex flex-col flex-1 gap-[20px] items-center justify-center" data-reveal="left">
                <h2 class="text-terqoise heading-6-medium">Coming Soon</h2>
                <div class="flex flex-col justify-center text-center gap-[20px]">
                {%- for workshop in workshops %}
                {%- if workshop.comingSoon %}
                    <h3 class="text-navy heading-1-bold">{{ workshop.name }}</h3>
                    <p class="text-small text-navy">More details coming soon</p>
                {%- endif %}
                {%- endfor %}
            </div>
            </div>
            <div class="flex-1 items-center justify-center flex" data-reveal="right">

<script>
    var swiperCards = new Swiper(".mySwiperCards", {
        effect: "cards",
        grabCursor: true,
    });
</script>

<script>
    var swiperTiktok = new Swiper(".mySwiperTiktok", {
        slidesPerView: 5,
        spaceBetween: 20,
        navigation: {
            nextEl: ".tiktok-swiper-button-next",
            prevEl: ".tiktok-swiper-button-prev",
        },
        breakpoints: {
            0: {
                slidesPerView: 2,
            },
            768: {
                slidesPerView: 3,
            },
            1024: {
                slidesPerView: 5,
            },
        },
    });

    document.querySelectorAll("[data-tiktok-toggle]").forEach(function (btn) {
        var video = btn.parentElement.querySelector("video");
        var iconPause = btn.querySelector("[data-icon-pause]");
        var iconPlay = btn.querySelector("[data-icon-play]");
        if (!video) return;

        btn.addEventListener("click", function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (video.paused) {
                video.play();
                btn.setAttribute("aria-label", "Pause video");
                iconPause.classList.remove("hidden");
                iconPlay.classList.add("hidden");
            } else {
                video.pause();
                btn.setAttribute("aria-label", "Play video");
                iconPause.classList.add("hidden");
                iconPlay.classList.remove("hidden");
            }
        });
    });
</script>